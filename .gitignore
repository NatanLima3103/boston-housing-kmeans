# Ambientes virtuais
.venv/
venv/
env/
ENV/

# Cache do Python
__pycache__/
*.py[cod]
*$py.class

# Cache de testes e cobertura
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Empacotamento
build/
dist/
*.egg-info/

# Base de dados: somente HousingData.csv, fornecida para a atividade, é versionada.
# Outros arquivos colocados em data/ (cópias, extrações, temporários) ficam fora do Git.
data/*
!data/.gitkeep
!data/HousingData.csv

# Treinamentos experimentais (K diferente de FINAL_K): regeneráveis com --k.
experiments/

# Credenciais e configuração local
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
secrets*.json
*token*.json

# Logs e arquivos temporários
*.log
logs/
tmp/
temp/
*.tmp
*.bak

# IDE e sistema operacional
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
